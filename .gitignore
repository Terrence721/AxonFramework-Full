# Gradle build artifacts can be ignored. Unlike Maven's target/, "build" is ALSO a real,
# tracked top-level directory name in this repo (build/checkstyle.xml, build/parent,
# build/coverage-report mirror the Maven source layout) - so this must not be a blanket
# `build/` pattern, or it would swallow that real content too. **/build/ ignores every
# module's own Gradle output dir (including nested ones like build/parent/build/); !/build/
# reopens the top-level directory so real content is visible; /build/* then re-excludes
# everything directly under it too - Gradle also treats the root project's own build output
# dir as /build/ (e.g. /build/reports/), the same path as the real module - except the
# specific real paths negated below.
**/build/
!/build/
/build/*
!/build/checkstyle.xml
!/build/parent/
!/build/coverage-report/
.gradle/
# ...but keep the wrapper jar and properties
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

axon.ipr
axon.iws

# IntelliJ project files
*.iml

# Eclipse project files
.classpath
.project
.settings/
.factorypath
/.metadata/

# Eclipse/JDT-style compiled-output dirs, written by the VS Code Java extension - scoped to
# main/test so this doesn't catch real content like docs/_samples/bin/compare-snippets.py
**/bin/main/
**/bin/test/

# MacOS makes this one
.DS_Store

# documentation's local build
docs/_playbook/build

# Python bytecode cache (docs/_samples/bin/compare-snippets.py)
__pycache__/

# Claude Code
.claude/settings.local.json
.ai/temp

# AI ASSISTANT - Kiro
.kiro

# Spec-kit (local use only, not committed, testing out)
.specify/
.claude/skills/speckit-*/

# AI ASSISTANT - Cursor
.cursor

# just - console helper
.justfile
